# Sakavi Sandbox configuration
# Copy to .env and adjust. NEVER put secrets, tokens, SSH keys, or cloud credentials here.

# Docker image name (build with: docker build -t sakavi-sandbox:latest .)
SANDBOX_IMAGE=sakavi-sandbox:latest

# Resource limits
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS=256
SANDBOX_TMP_SIZE=512m

# Timeouts (milliseconds)
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MAX_TIMEOUT_MS=600000

# Max captured output size (bytes)
SANDBOX_MAX_OUTPUT=1048576

# Network mode for new sandboxes: "none" (safest) or "bridge"
SANDBOX_NETWORK=none

# Optional: absolute path used by docker-compose demo
# PROJECT_PATH=/absolute/path/to/your/project
